{
  "$schema": "https://json.schemastore.org/staticwebapp.config.json",
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/_next/*",
      "/backgrounds/*",
      "/logos/*",
      "/portfolio/*",
      "/*.{png,jpg,jpeg,webp,svg,ico,json,txt}"
    ]
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/404/index.html"
    }
  },
  "globalHeaders": {
    "Cache-Control": "public, max-age=0, must-revalidate"
  },
  "mimeTypes": {
    ".json": "application/json",
    ".webp": "image/webp"
  }
}
